{
  "name": "@local/proofcard-dsh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turns each completed turn into a proof receipt: the claims the agent made, the session evidence behind them, and one click to accept or challenge.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "claims.js",
    "evidence.js",
    "receipts.js",
    "store.js",
    "redact.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
